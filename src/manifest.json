{
  "manifest_version": 3,
  "name": "Kakomi",
  "version": "1.3.1",
  "description": "Click an element or drag an area to capture. Copy screenshots instantly or open a preview.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "options_ui": { "page": "settings.html", "open_in_tab": true },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Kakomi — pick an element", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "web_accessible_resources": [{ "resources": ["clipboard.html", "clipboard.js"], "matches": ["<all_urls>"] }],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Select an element to screenshot"
    }
  }
}
